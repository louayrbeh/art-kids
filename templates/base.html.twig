<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Art Kids{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>AK</text></svg>">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
            <link rel="stylesheet" href="{{ asset('assets/css/artkids-theme.css') }}">
            <link rel="stylesheet" href="{{ asset('assets/css/artkids-forms.css') }}">
            <link rel="stylesheet" href="{{ asset('assets/css/artkids-animations.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script defer src="{{ asset('assets/js/artkids-ui.js') }}"></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="artkids-body {% block body_class %}{% endblock %}">
        {% block navbar %}
            <nav class="navbar navbar-expand-lg navbar-light art-navbar sticky-top">
                <div class="container art-navbar-shell">
                    <a class="navbar-brand art-brand" href="{{ path('app_front_home') }}">
                        <span class="art-brand-mark"><i class="bi bi-palette2"></i></span>
                        <span><span class="art-brand-art">Art</span><span class="art-brand-kids">Kids</span></span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Ouvrir le menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav mx-auto art-navbar-links">
                            {% if not app.user %}
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_home') }}">Accueil</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_home') ~ '#activites' }}">Activites</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_home') ~ '#a-propos' }}">A propos</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_home') ~ '#ressources' }}">Ressources</a></li>
                            {% endif %}

                            {% if is_granted('ROLE_PARENT') %}
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_parent_index') }}">Espace parent</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_child_index') }}">Mes enfants</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_activity_index') }}">Activites</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_reservation_index') }}">Reservations</a></li>
                            {% endif %}

                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_back_admin_index') }}">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_back_category_index') }}">Categories</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_back_activity_index') }}">Activites</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_back_user_index') }}">Utilisateurs</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_back_reservation_index') }}">Reservations</a></li>
                            {% endif %}
                        </ul>

                        <div class="d-flex align-items-center gap-3 art-navbar-user">
                            {% if app.user %}
                                <span class="small fw-semibold">{{ app.user.fullName }}</span>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a class="btn btn-art-secondary btn-sm" href="{{ path('app_back_admin_index') }}">Administration</a>
                                {% elseif is_granted('ROLE_PARENT') %}
                                    <a class="btn btn-art-secondary btn-sm" href="{{ path('app_front_parent_index') }}">Mon espace</a>
                                {% endif %}
                                <a class="btn btn-art-outline btn-sm" href="{{ path('app_front_logout') }}">Deconnexion</a>
                            {% else %}
                                <a class="btn btn-art-outline btn-sm" href="{{ path('app_front_login') }}">Se connecter</a>
                                <a class="btn btn-art-primary btn-sm" href="{{ path('app_front_register') }}">S'inscrire</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </nav>
        {% endblock %}

        <main class="art-main {% block main_class %}container py-4{% endblock %}">
            {% block flashes %}
                {% set flashIcons = {
                    success: 'bi-check2-circle',
                    error: 'bi-exclamation-octagon',
                    danger: 'bi-exclamation-octagon',
                    warning: 'bi-exclamation-triangle',
                    info: 'bi-info-circle'
                } %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% set normalized = label == 'error' ? 'danger' : label %}
                        <div class="alert alert-{{ normalized }} art-flash alert-dismissible fade show slide-up" role="alert">
                            <span class="art-flash__icon"><i class="bi {{ flashIcons[normalized] ?? 'bi-bell' }}"></i></span>
                            <div class="art-flash__content">{{ message }}</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
