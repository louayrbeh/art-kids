{% extends 'front_office/layout.html.twig' %}

{% block title %}Activites disponibles | Art Kids{% endblock %}

{% block parent_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Activites disponibles</h1>
            <p class="text-muted mb-0">Consultez uniquement les activites ouvertes, futures et encore reservables.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-4" href="{{ path('app_front_parent_index') }}">Retour au dashboard</a>
    </div>

    <div class="parent-surface p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-5">
                <label class="form-label" for="activity-search">Recherche</label>
                <input id="activity-search" type="text" class="form-control rounded-4" name="q" value="{{ filters.q }}" placeholder="Rechercher par titre">
            </div>
            <div class="col-lg-3">
                <label class="form-label" for="activity-category">Categorie</label>
                <select id="activity-category" class="form-select rounded-4" name="category">
                    <option value="">Toutes les categories</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>{{ category.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label" for="activity-age">Age</label>
                <input id="activity-age" type="number" min="0" class="form-control rounded-4" name="age" value="{{ filters.age }}">
            </div>
            <div class="col-lg-2">
                <button class="btn btn-primary rounded-4 w-100">Filtrer</button>
            </div>
        </form>
    </div>

    <div class="row g-4">
        {% for activity in activities %}
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <img class="parent-card-media activity-image" src="{{ activity_image_url(activity.image) }}" alt="{{ activity.titre }}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div class="small text-muted">{{ activity.category.nom }}</div>
                            <span class="badge text-bg-success">{{ activity.statut.value }}</span>
                        </div>
                        <h2 class="h5">{{ activity.titre }}</h2>
                        <p class="text-muted">{{ activity.description|length > 120 ? activity.description|slice(0, 120) ~ '...' : activity.description }}</p>
                        <ul class="list-unstyled small mb-4">
                            <li>Date : {{ activity.dateActivite|date('d/m/Y') }}</li>
                            <li>Horaire : {{ activity.heureDebut|date('H:i') }} - {{ activity.heureFin|date('H:i') }}</li>
                            <li>Lieu : {{ activity.lieu ?: 'A definir' }}</li>
                            <li>Prix : {{ activity.prix ? activity.prix ~ ' TND' : 'Gratuit' }}</li>
                            <li>Age : {{ activity.ageMin }} - {{ activity.ageMax }} ans</li>
                            <li>Places disponibles : {{ activity.placesDisponibles }}</li>
                        </ul>
                        <a class="btn btn-primary rounded-4" href="{{ path('app_front_activity_show', {id: activity.id}) }}">Voir details</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="parent-empty">Aucune activite ne correspond a vos filtres pour le moment.</div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
