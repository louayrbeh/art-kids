{% extends 'base.html.twig' %}

{% block title %}Espace parent | Art Kids{% endblock %}

{% block body %}
    <div class="p-4 mb-4 bg-white border rounded-3">
        <h1 class="h3 mb-2">Espace parent</h1>
        <p class="mb-0">Bonjour {{ parent.fullName }}. Cette page sert de point d'entree simple vers vos fonctionnalites principales.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Mes enfants</h2>
                    <p class="text-muted">Ajoutez, modifiez et consultez vos enfants.</p>
                    <a class="btn btn-primary" href="{{ path('app_front_child_index') }}">Gerer mes enfants</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Activites disponibles</h2>
                    <p class="text-muted">Consultez les ateliers ouverts et a venir.</p>
                    <a class="btn btn-primary" href="{{ path('app_front_activity_index') }}">Voir les activites</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Mes reservations</h2>
                    <p class="text-muted">Vous avez actuellement {{ reservationCount }} reservation(s).</p>
                    <a class="btn btn-primary" href="{{ path('app_front_reservation_index') }}">Voir l'historique</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
