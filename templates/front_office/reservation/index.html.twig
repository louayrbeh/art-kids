{% extends 'base.html.twig' %}

{% block title %}Mes reservations | Art Kids{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Mes reservations</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            {% if reservations %}
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Enfant</th>
                                <th>Activite</th>
                                <th>Date activite</th>
                                <th>Statut</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in reservations %}
                                <tr>
                                    <td>{{ reservation.child.fullName }}</td>
                                    <td>{{ reservation.activity.titre }}</td>
                                    <td>{{ reservation.activity.dateActivite|date('d/m/Y') }}</td>
                                    <td>{{ reservation.statut.value }}</td>
                                    <td class="text-end">
                                        {% if not reservation.estAnnulee %}
                                            <form method="post" action="{{ path('app_front_reservation_cancel', {id: reservation.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Annuler cette reservation ?');">Annuler</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">Aucune reservation pour le moment.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
