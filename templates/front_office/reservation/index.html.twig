{% extends 'front_office/layout.html.twig' %}

{% set reservationBadgeMap = {
    'EN_ATTENTE': 'warning',
    'CONFIRMEE': 'success',
    'ANNULEE': 'danger',
    'TERMINEE': 'secondary'
} %}

{% block title %}Mes reservations | Art Kids{% endblock %}

{% block parent_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">Mes reservations</h1>
            <p class="art-page-subtitle">Historique complet des reservations de vos enfants.</p>
        </div>
        <a class="btn btn-art-secondary" href="{{ path('app_front_parent_index') }}">Retour au dashboard</a>
    </div>

    <div class="art-table-card">
        {% if reservations %}
            <div class="table-responsive">
                <table class="table art-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Enfant</th>
                            <th>Activite</th>
                            <th>Categorie</th>
                            <th>Date activite</th>
                            <th>Date reservation</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in reservations %}
                            <tr>
                                <td>#{{ reservation.id }}</td>
                                <td>{{ reservation.child.fullName }}</td>
                                <td>{{ reservation.activity.titre }}</td>
                                <td>{{ reservation.activity.category.nom }}</td>
                                <td>{{ reservation.activity.dateActivite|date('d/m/Y') }}</td>
                                <td>{{ reservation.dateReservation|date('d/m/Y H:i') }}</td>
                                <td><span class="art-badge {{ reservationBadgeMap[reservation.statut.value] == 'success' ? 'badge-art-success' : (reservationBadgeMap[reservation.statut.value] == 'warning' ? 'badge-art-warning' : (reservationBadgeMap[reservation.statut.value] == 'danger' ? 'badge-art-danger' : 'badge-art-muted')) }}">{{ reservation.statut.value }}</span></td>
                                <td class="text-end">
                                    <a class="art-action-btn art-action-view" href="{{ path('app_front_reservation_show', {id: reservation.id}) }}" title="Voir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    {% if reservation.statut.value not in ['ANNULEE', 'TERMINEE'] %}
                                        <form method="post" action="{{ path('app_front_reservation_cancel', {id: reservation.id}) }}" class="d-inline" data-turbo="false">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                            <button type="submit" class="art-action-btn art-action-delete" onclick="return confirm('Annuler cette reservation ?');" title="Annuler">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="art-empty-state">
                <i class="bi bi-journal-check"></i>
                <h3>Aucune reservation</h3>
                <p class="mb-0">Vos inscriptions à venir et passées apparaîtront ici.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
