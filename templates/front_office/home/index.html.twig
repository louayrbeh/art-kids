{% extends 'base.html.twig' %}

{% block title %}ArtKids | Activites artistiques pour enfants{% endblock %}

{% block body_class %}bg-white{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block navbar %}
    <nav class="navbar navbar-expand-lg home-navbar sticky-top">
        <div class="container home-container">
            <a class="navbar-brand home-brand" href="{{ path('app_front_home') }}">
                <span class="home-brand__icon">🎨</span>
                <span class="home-brand__text">
                    <span class="home-brand__art">Art</span><span class="home-brand__kids">Kids</span>
                </span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#homeMainNav" aria-controls="homeMainNav" aria-expanded="false" aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="homeMainNav">
                <ul class="navbar-nav mx-auto home-nav-links">
                    <li class="nav-item"><a class="nav-link active" href="#accueil">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link" href="#a-propos">A propos</a></li>
                    <li class="nav-item"><a class="nav-link" href="#activites">Activites</a></li>
                    <li class="nav-item"><a class="nav-link" href="#comment-marche">Comment ca marche</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                </ul>

                <div class="home-nav-actions">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="btn home-btn home-btn-outline" href="{{ path('app_back_admin_index') }}">
                                <i class="bi bi-speedometer2"></i>
                                Administration
                            </a>
                        {% elseif is_granted('ROLE_PARENT') %}
                            <a class="btn home-btn home-btn-outline" href="{{ path('app_front_parent_index') }}">
                                <i class="bi bi-person-circle"></i>
                                Mon espace
                            </a>
                        {% endif %}
                        <a class="btn home-btn home-btn-primary" href="{{ path('app_front_logout') }}">
                            <i class="bi bi-box-arrow-right"></i>
                            Deconnexion
                        </a>
                    {% else %}
                        <a class="btn home-btn home-btn-outline" href="{{ path('app_front_login') }}">
                            <i class="bi bi-person"></i>
                            Se connecter
                        </a>
                        <a class="btn home-btn home-btn-primary" href="{{ path('app_front_register') }}">
                            <i class="bi bi-person-plus"></i>
                            S'inscrire
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>
{% endblock %}

{% block main_class %}home-main{% endblock %}

{% block body %}
    <section class="home-hero-section" id="accueil">
        <div class="container home-container">
            <div class="home-hero">
                <div class="home-hero__decor home-hero__decor--left"></div>
                <div class="home-hero__decor home-hero__decor--right"></div>
                <div class="row g-5 align-items-center">
                    <div class="col-xl-6 col-lg-7">
                        <div class="home-hero__content" id="a-propos">
                            <span class="home-badge">La creativite commence ici 🎨</span>
                            <h1 class="home-title">
                                Des activites artistiques
                                pour <span>reveler le talent</span>
                                de vos enfants
                            </h1>
                            <p class="home-description">
                                ArtKids est une plateforme dediee a la decouverte et a la gestion des activites artistiques pour enfants.
                                Inscrivez vos enfants, suivez leurs reservations et laissez-les s'epanouir.
                            </p>

                            <div class="home-hero__actions">
                                <a class="btn home-btn home-btn-primary home-btn-lg" href="{{ path('app_front_register') }}">
                                    <i class="bi bi-person-plus"></i>
                                    S'inscrire
                                </a>
                                <a class="btn home-btn home-btn-outline home-btn-lg" href="{{ path('app_front_login') }}">
                                    <i class="bi bi-person"></i>
                                    Se connecter
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-5">
                        <div class="home-hero__visual">
                            <div class="hero-media">
                                <div class="hero-media__shape hero-media__shape--star"><i class="bi bi-star"></i></div>
                                <div class="hero-media__shape hero-media__shape--palette"><i class="bi bi-palette2"></i></div>
                                <div class="hero-media__shape hero-media__shape--wave"></div>
                                <div class="hero-media__image"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section" id="activites">
        <div class="container home-container">
            <div class="home-section__heading">
                <span class="home-section__eyebrow">Nos activites</span>
                <h2 class="home-section__title">Explorez nos univers artistiques</h2>
                <p class="home-section__subtitle">Une variete d'activites pour stimuler la creativite et l'imagination de vos enfants.</p>
            </div>

            <div class="row g-4">
                {% for universe in universes %}
                    <div class="col-12 col-sm-6 col-xl-2">
                        <article class="universe-card universe-card--{{ universe.theme }}">
                            <div class="universe-card__icon">{{ universe.icon }}</div>
                            <h3 class="universe-card__title">{{ universe.title }}</h3>
                            <p class="universe-card__text">{{ universe.description }}</p>
                        </article>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-section home-section--soft" id="comment-marche">
        <div class="container home-container">
            <div class="home-section__heading">
                <span class="home-section__eyebrow">Comment ca marche</span>
                <h2 class="home-section__title">Une experience simple, rassurante et fluide</h2>
            </div>

            <div class="row g-4">
                {% for step in steps %}
                    <div class="col-md-4">
                        <article class="step-card">
                            <span class="step-card__number">{{ step.number }}</span>
                            <h3 class="step-card__title">{{ step.title }}</h3>
                            <p class="step-card__text">{{ step.description }}</p>
                        </article>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-section pt-0">
        <div class="container home-container">
            <div class="stats-panel">
                <div class="row g-3">
                    {% for stat in stats %}
                        <div class="col-12 col-md-6 col-xl-3">
                            <article class="stat-card">
                                <div class="stat-card__icon stat-card__icon--{{ stat.theme }}">
                                    <i class="bi {{ stat.icon }}"></i>
                                </div>
                                <div class="stat-card__content">
                                    <div class="stat-card__value">{{ stat.value }}</div>
                                    <div class="stat-card__title">{{ stat.title }}</div>
                                    <div class="stat-card__subtitle">{{ stat.subtitle }}</div>
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <section class="home-section pt-0" id="contact">
        <div class="container home-container">
            <div class="contact-banner">
                <div>
                    <span class="home-section__eyebrow mb-2 d-inline-block">Contact</span>
                    <h2 class="contact-banner__title">Envie d'offrir une aventure artistique a votre enfant ?</h2>
                    <p class="contact-banner__text mb-0">Creez votre compte parent et commencez a explorer les activites ArtKids des aujourd'hui.</p>
                </div>
                <div class="contact-banner__actions">
                    <a class="btn home-btn home-btn-primary home-btn-lg" href="{{ path('app_front_register') }}">S'inscrire</a>
                    <a class="btn home-btn home-btn-outline home-btn-lg" href="{{ path('app_front_login') }}">Se connecter</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
