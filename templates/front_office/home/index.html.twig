{% extends 'base.html.twig' %}

{% block title %}Accueil | Art Kids{% endblock %}

{% block body %}
    <div class="p-4 mb-4 bg-white border rounded-3">
        <h1 class="h3 mb-3">Bienvenue sur Art Kids</h1>
        <p class="mb-0">Cette page reste volontairement simple pour cette premiere etape. Vous pouvez deja vous inscrire, vous connecter, gerer les enfants et consulter les activites.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Activites a venir</h2>
                    {% if activities %}
                        <div class="list-group list-group-flush">
                            {% for activity in activities %}
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold">{{ activity.titre }}</div>
                                            <div class="text-muted small">{{ activity.category.nom }} | {{ activity.dateActivite|date('d/m/Y') }} | {{ activity.lieu ?: 'Lieu a confirmer' }}</div>
                                        </div>
                                        <span class="badge text-bg-primary">{{ activity.placesDisponibles }} places</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">Aucune activite ouverte pour le moment.</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Acces rapides</h2>
                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" href="{{ path('app_front_register') }}">Creer un compte parent</a>
                        <a class="btn btn-outline-secondary" href="{{ path('app_front_login') }}">Se connecter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
