{% extends 'base.html.twig' %}

{% block title %}ArtKids | Plateforme creative pour enfants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-compact.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-card-spacing.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-public-navbar.css') }}">
{% endblock %}

{% block navbar %}
    {% include 'components/_public_navbar.html.twig' %}
{% endblock %}

{% block main_class %}home-main{% endblock %}

{% block body %}
    <section class="home-cinematic" id="studio">
        <div class="home-shader" aria-hidden="true"></div>
        <div class="container home-container">
            <div class="home-shell home-shell--cinematic">
                <div class="home-orbit home-orbit--one"></div>
                <div class="home-orbit home-orbit--two"></div>
                <div class="home-orbit home-orbit--three"></div>

                <div class="row g-5 align-items-center">
                    <div class="col-xl-6">
                        <div class="home-hero-copy">
                            <span class="home-badge"><i data-lucide="wand-sparkles"></i> Studio artistique pour familles modernes</span>
                            <h1 class="home-title">Organisez des aventures creatives qui donnent envie d'apprendre.</h1>
                            <p class="home-description">
                                ArtKids aide les parents a decouvrir, comparer et reserver des activites artistiques adaptees a chaque enfant, pendant que l'equipe admin pilote le catalogue, les inscriptions et les disponibilites.
                            </p>

                            <div class="home-hero__actions">
                                <a class="btn home-btn home-btn-primary home-btn-lg" href="{{ path('app_front_register') }}">
                                    <i data-lucide="rocket"></i>
                                    Demarrer comme parent
                                </a>
                                <a class="btn home-btn home-btn-outline home-btn-lg" href="{{ path('app_front_login') }}">
                                    <i data-lucide="shield-check"></i>
                                    Acceder a mon espace
                                </a>
                            </div>

                            <div class="home-trust-row">
                                <span><i data-lucide="palette"></i> Peinture, musique, theatre</span>
                                <span><i data-lucide="calendar-check"></i> Reservations centralisees</span>
                                <span><i data-lucide="sparkles"></i> Recommandations intelligentes</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6">
                        <div class="home-studio-card">
                            <div class="home-studio-card__top">
                                <span class="home-live-dot"></span>
                                <span>ArtKids Creative OS</span>
                                <strong>Live</strong>
                            </div>
                            <div class="home-studio-canvas">
                                <div class="home-studio-orb home-studio-orb--paint"><i data-lucide="paintbrush"></i></div>
                                <div class="home-studio-orb home-studio-orb--music"><i data-lucide="music-2"></i></div>
                                <div class="home-studio-orb home-studio-orb--stage"><i data-lucide="drama"></i></div>
                                <div class="home-studio-panel">
                                    <span>Profil enfant</span>
                                    <strong>Age, envies, disponibilites</strong>
                                </div>
                                <div class="home-studio-panel home-studio-panel--right">
                                    <span>Reservation</span>
                                    <strong>Places restantes en temps reel</strong>
                                </div>
                            </div>
                            <div class="home-studio-card__bottom">
                                <div>
                                    <span>Activite conseillee</span>
                                    <strong>Atelier peinture expressive</strong>
                                </div>
                                <a href="{{ path('app_front_register') }}">Explorer <i data-lucide="arrow-up-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section" id="modules">
        <div class="container home-container">
            <div class="home-section__heading">
                <span class="home-section__eyebrow">Modules artistiques</span>
                <h2 class="home-section__title">Un catalogue vivant pour nourrir la curiosite.</h2>
                <p class="home-section__subtitle">Chaque discipline devient une porte d'entree vers l'expression, la confiance et l'apprentissage par la pratique.</p>
            </div>

            <div class="home-bento-grid">
                {% for universe in universes %}
                    <article class="home-bento-card home-bento-card--{{ loop.index is odd ? 'wide' : 'standard' }}">
                        <div class="home-bento-card__icon"><i class="{{ universe.icon }}"></i></div>
                        <div>
                            <span class="home-bento-card__meta">Univers {{ loop.index }}</span>
                            <h3>{{ universe.title }}</h3>
                            <p>{{ universe.description }}</p>
                        </div>
                        <span class="home-bento-card__chip">3-12 ans</span>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-section" id="experience">
        <div class="container home-container">
            <div class="home-experience-grid">
                <div class="home-panel home-panel--feature">
                    <span class="home-section__eyebrow">Pour les parents</span>
                    <h2 class="home-panel__title">Une experience claire, rassurante et actionnable.</h2>
                    <p>Ajoutez vos enfants, consultez les activites ouvertes, choisissez une activite compatible avec l'age, puis suivez les reservations depuis un tableau de bord unique.</p>
                    <div class="home-feature-list">
                        <span><i data-lucide="users-round"></i> Gestion des profils enfants</span>
                        <span><i data-lucide="ticket-check"></i> Reservations et annulations</span>
                        <span><i data-lucide="brain-circuit"></i> Suggestions adaptees</span>
                    </div>
                    <a class="btn home-btn home-btn-primary" href="{{ path('app_front_register') }}">Creer mon espace parent</a>
                </div>

                <div class="home-panel home-panel--feature">
                    <span class="home-section__eyebrow">Pour l'administration</span>
                    <h2 class="home-panel__title">Un cockpit SaaS pour piloter l'activite.</h2>
                    <p>Categories, activites, images, utilisateurs, reservations, capacites et statistiques restent centralises dans un back-office professionnel.</p>
                    <div class="home-feature-list">
                        <span><i data-lucide="bar-chart-3"></i> Dashboard statistique</span>
                        <span><i data-lucide="image-up"></i> Uploads et catalogue</span>
                        <span><i data-lucide="bot"></i> Description IA assistee</span>
                    </div>
                    <a class="btn home-btn home-btn-outline" href="{{ path('app_front_login') }}">Connexion equipe</a>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section" id="pilotage">
        <div class="container home-container">
            <div class="home-metrics">
                {% for stat in stats %}
                    <article class="stat-card home-metric-card">
                        <div class="stat-card__icon stat-card__icon--{{ stat.theme }}">
                            <i class="bi {{ stat.icon }}"></i>
                        </div>
                        <div>
                            <div class="stat-card__value">{{ stat.value }}</div>
                            <div class="stat-card__title">{{ stat.title }}</div>
                            <div class="stat-card__subtitle">{{ stat.subtitle }}</div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-section pt-0">
        <div class="container home-container">
            <div class="contact-banner">
                <div>
                    <span class="home-section__eyebrow mb-2 d-inline-block">Pret pour la prochaine creation ?</span>
                    <h2 class="contact-banner__title">Transformez la gestion des ateliers en experience premium.</h2>
                    <p class="contact-banner__text mb-0">ArtKids relie familles, enfants et administrateurs dans une interface creative, lisible et prete pour la demonstration.</p>
                </div>
                <div class="contact-banner__actions">
                    <a class="btn home-btn home-btn-primary home-btn-lg" href="{{ path('app_front_register') }}">Creer un compte parent</a>
                    <a class="btn home-btn home-btn-outline home-btn-lg" href="{{ path('app_front_login') }}">Se connecter</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
