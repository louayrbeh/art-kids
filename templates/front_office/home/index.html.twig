{% extends 'base.html.twig' %}

{% block title %}ArtKids | Activites artistiques pour enfants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-home.css') }}">
{% endblock %}

{% block navbar %}
    <nav class="navbar navbar-expand-lg home-navbar sticky-top">
        <div class="container home-container">
            <a class="navbar-brand home-brand" href="{{ path('app_front_home') }}">
                <span class="home-brand__icon"><i class="bi bi-palette2"></i></span>
                <span class="home-brand__text">
                    <span class="home-brand__art">Art</span><span class="home-brand__kids">Kids</span>
                </span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#homeMainNav" aria-controls="homeMainNav" aria-expanded="false" aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="homeMainNav">
                <ul class="navbar-nav mx-auto home-nav-links">
                    <li class="nav-item"><a class="nav-link active" href="#accueil">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link" href="#activites">Activites</a></li>
                    <li class="nav-item"><a class="nav-link" href="#a-propos">A propos</a></li>
                    <li class="nav-item"><a class="nav-link" href="#ressources">Ressources</a></li>
                </ul>

                <div class="home-nav-actions">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="btn home-btn home-btn-outline" href="{{ path('app_back_admin_index') }}">
                                <i class="bi bi-speedometer2"></i>
                                Administration
                            </a>
                        {% elseif is_granted('ROLE_PARENT') %}
                            <a class="btn home-btn home-btn-outline" href="{{ path('app_front_parent_index') }}">
                                <i class="bi bi-person-circle"></i>
                                Mon espace
                            </a>
                        {% endif %}
                        <a class="btn home-btn home-btn-primary" href="{{ path('app_front_logout') }}">
                            <i class="bi bi-box-arrow-right"></i>
                            Deconnexion
                        </a>
                    {% else %}
                        <a class="btn home-btn home-btn-outline" href="{{ path('app_front_login') }}">
                            <i class="bi bi-person"></i>
                            Se connecter
                        </a>
                        <a class="btn home-btn home-btn-primary" href="{{ path('app_front_register') }}">
                            <i class="bi bi-person-plus"></i>
                            S'inscrire
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>
{% endblock %}

{% block main_class %}home-main{% endblock %}

{% block body %}
    <section class="home-hero-section" id="accueil">
        <div class="container home-container">
            <div class="home-shell">
                <span class="art-orb art-orb--pink home-orb home-orb--one"></span>
                <span class="art-orb art-orb--violet home-orb home-orb--two"></span>
                <span class="art-orb art-orb--blue home-orb home-orb--three"></span>
                <span class="art-orb art-orb--warm home-orb home-orb--four"></span>

                <div class="home-hero">
                    <div class="row g-5 align-items-center">
                        <div class="col-xl-5 col-lg-6">
                            <div class="home-hero__content" id="a-propos">
                                <span class="home-badge"><i class="bi bi-stars"></i>La creativite commence ici</span>
                                <h1 class="home-title">
                                    Eveillons leur talent,
                                    cultivons leur <span>imagination</span>
                                </h1>
                                <p class="home-description">
                                    ArtKids est la plateforme dediee aux enfants de 3 a 12 ans pour decouvrir,
                                    apprendre et s amuser a travers l art.
                                </p>

                                <div class="home-hero__actions">
                                    <a class="btn home-btn home-btn-primary home-btn-lg" href="{{ path('app_front_register') }}">
                                        <i class="bi bi-stars"></i>
                                        S'inscrire gratuitement
                                    </a>
                                    <a class="btn home-btn home-btn-outline home-btn-lg" href="{{ path('app_front_login') }}">
                                        <i class="bi bi-play-circle"></i>
                                        Se connecter
                                    </a>
                                </div>

                                <div class="home-feature-pills" id="ressources">
                                    <span class="home-feature-pill"><i class="bi bi-display"></i>Ateliers en ligne</span>
                                    <span class="home-feature-pill"><i class="bi bi-heart"></i>Encadrement bienveillant</span>
                                    <span class="home-feature-pill"><i class="bi bi-shield-check"></i>Sans engagement</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-7 col-lg-6">
                            <div class="home-hero__visual">
                                <div class="hero-media">
                                    <div class="hero-media__spark hero-media__spark--one"><i class="bi bi-star-fill"></i></div>
                                    <div class="hero-media__spark hero-media__spark--two"><i class="bi bi-stars"></i></div>
                                    <div class="hero-media__bubble hero-media__bubble--palette"><i class="bi bi-palette2"></i></div>
                                    <div class="hero-media__bubble hero-media__bubble--rainbow"><i class="bi bi-brush"></i></div>
                                    <div class="hero-media__image"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 home-spotlights" id="activites">
                    <div class="col-xl-7">
                        <div class="home-panel">
                            <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                                <div>
                                    <span class="home-section__eyebrow">Nos activites phares</span>
                                    <h2 class="home-panel__title">Des univers artistiques qui donnent envie de creer</h2>
                                </div>
                                <a class="home-panel__link" href="{{ path('app_front_register') }}">Voir toutes les activites <i class="bi bi-arrow-right"></i></a>
                            </div>
                            <div class="row g-3">
                                {% for universe in universes|slice(0, 4) %}
                                    <div class="col-sm-6 col-xl-3">
                                        <article class="home-spotlight-card home-spotlight-card--{{ universe.theme }}">
                                            <div class="home-spotlight-card__icon"><i class="{{ universe.icon }}"></i></div>
                                            <h3 class="home-spotlight-card__title">{{ universe.title }}</h3>
                                            <p class="home-spotlight-card__text">{{ universe.description }}</p>
                                            <span class="home-spotlight-card__age">3-12 ans</span>
                                        </article>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-5">
                        <div class="home-panel">
                            <span class="home-section__eyebrow">Pourquoi choisir ArtKids ?</span>
                            <h2 class="home-panel__title">Une plateforme pensee pour rassurer les parents et inspirer les enfants</h2>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <article class="home-benefit-card">
                                        <span class="home-benefit-card__icon"><i class="bi bi-lightbulb"></i></span>
                                        <h3>Developpe la creativite</h3>
                                        <p>Des activites concues pour stimuler l imagination au quotidien.</p>
                                    </article>
                                </div>
                                <div class="col-sm-6">
                                    <article class="home-benefit-card">
                                        <span class="home-benefit-card__icon"><i class="bi bi-star"></i></span>
                                        <h3>Apprentissage ludique</h3>
                                        <p>Apprendre en s amusant grace a des projets varies et motivants.</p>
                                    </article>
                                </div>
                                <div class="col-sm-6">
                                    <article class="home-benefit-card">
                                        <span class="home-benefit-card__icon"><i class="bi bi-person-heart"></i></span>
                                        <h3>Encadrement expert</h3>
                                        <p>Des animateurs passionnes et des ateliers adaptes a chaque age.</p>
                                    </article>
                                </div>
                                <div class="col-sm-6">
                                    <article class="home-benefit-card">
                                        <span class="home-benefit-card__icon"><i class="bi bi-globe2"></i></span>
                                        <h3>Accessible a tous</h3>
                                        <p>En ligne ou a votre rythme, avec une gestion simple et fluide.</p>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 home-metrics-row">
                    <div class="col-xl-7">
                        <div class="stats-panel">
                            <div class="row g-3">
                                {% for stat in stats %}
                                    <div class="col-12 col-md-6 col-xl-3">
                                        <article class="stat-card">
                                            <div class="stat-card__icon stat-card__icon--{{ stat.theme }}">
                                                <i class="bi {{ stat.icon }}"></i>
                                            </div>
                                            <div class="stat-card__content">
                                                <div class="stat-card__value">{{ stat.value }}</div>
                                                <div class="stat-card__title">{{ stat.title }}</div>
                                                <div class="stat-card__subtitle">{{ stat.subtitle }}</div>
                                            </div>
                                        </article>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <div class="home-testimonial">
                            <div class="home-testimonial__avatar"></div>
                            <div>
                                <p class="home-testimonial__quote">"Ma fille adore les ateliers ! Elle a gagne en confiance et passe des heures a creer. Merci ArtKids !"</p>
                                <p class="home-testimonial__author mb-0">Sophie, maman de Lea (7 ans)</p>
                            </div>
                            <button type="button" class="home-testimonial__arrow" aria-label="Temoignage suivant">
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="container home-container">
            <div class="home-section__heading">
                <span class="home-section__eyebrow">Explorer plus loin</span>
                <h2 class="home-section__title">Tous les univers pour eveiller la curiosite des enfants</h2>
                <p class="home-section__subtitle">Une variete d activites pour stimuler la creativite et l imagination a travers plusieurs disciplines artistiques.</p>
            </div>

            <div class="row g-4">
                {% for universe in universes %}
                    <div class="col-12 col-sm-6 col-xl-2">
                        <article class="universe-card universe-card--{{ universe.theme }}">
                            <div class="universe-card__icon"><i class="{{ universe.icon }}"></i></div>
                            <h3 class="universe-card__title">{{ universe.title }}</h3>
                            <p class="universe-card__text">{{ universe.description }}</p>
                        </article>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-section home-section--soft">
        <div class="container home-container">
            <div class="home-section__heading">
                <span class="home-section__eyebrow">Comment ca marche</span>
                <h2 class="home-section__title">Une experience simple, rassurante et fluide</h2>
            </div>

            <div class="row g-4">
                {% for step in steps %}
                    <div class="col-md-4">
                        <article class="step-card">
                            <span class="step-card__number">{{ step.number }}</span>
                            <h3 class="step-card__title">{{ step.title }}</h3>
                            <p class="step-card__text">{{ step.description }}</p>
                        </article>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-section pt-0">
        <div class="container home-container">
            <div class="contact-banner">
                <div>
                    <span class="home-section__eyebrow mb-2 d-inline-block">Pret a commencer ?</span>
                    <h2 class="contact-banner__title">Offrez une aventure artistique memorable a votre enfant</h2>
                    <p class="contact-banner__text mb-0">Creez votre compte parent, ajoutez vos enfants et commencez a reserver les activites qui correspondent a leur energie et leur imagination.</p>
                </div>
                <div class="contact-banner__actions">
                    <a class="btn home-btn home-btn-primary home-btn-lg" href="{{ path('app_front_register') }}">S'inscrire</a>
                    <a class="btn home-btn home-btn-outline home-btn-lg" href="{{ path('app_front_login') }}">Se connecter</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
