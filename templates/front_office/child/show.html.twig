{% extends 'front_office/layout.html.twig' %}

{% block title %}Mon enfant | Art Kids{% endblock %}

{% block parent_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">{{ child.fullName }}</h1>
            <p class="text-muted mb-0">Consultez les informations, l historique de reservations et les recommandations de votre enfant.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary rounded-4" href="{{ path('app_front_child_edit', {id: child.id}) }}">Modifier</a>
            <a class="btn btn-outline-secondary rounded-4" href="{{ path('app_front_child_index') }}">Retour</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="parent-surface p-4 h-100">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Date de naissance</dt>
                    <dd class="col-sm-7">{{ child.dateNaissance|date('d/m/Y') }}</dd>
                    <dt class="col-sm-5">Age</dt>
                    <dd class="col-sm-7">{{ child.age }} ans</dd>
                    <dt class="col-sm-5">Sexe</dt>
                    <dd class="col-sm-7">{{ child.sexe.value }}</dd>
                    <dt class="col-sm-5">Reservations</dt>
                    <dd class="col-sm-7">{{ child.reservations|length }}</dd>
                </dl>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="parent-surface p-4 h-100">
                <h2 class="h5 mb-3">Historique des reservations</h2>
                {% if child.reservations|length > 0 %}
                    <ul class="list-group list-group-flush">
                        {% for reservation in child.reservations %}
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">{{ reservation.activity.titre }}</div>
                                    <div class="small text-muted">{{ reservation.dateReservation|date('d/m/Y H:i') }} - {{ reservation.statut.value }}</div>
                                </div>
                                <a class="btn btn-sm btn-outline-secondary rounded-3" href="{{ path('app_front_reservation_show', {id: reservation.id}) }}">Voir</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="parent-empty">Aucune reservation pour cet enfant.</div>
                {% endif %}
            </div>
        </div>
    </div>

    <section id="recommendations" class="parent-surface p-4 mt-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="h4 mb-1">Activites recommandees pour {{ child.prenom }}</h2>
                <p class="text-muted mb-0">Des activites selectionnees selon son age, sa disponibilite et son parcours creatif.</p>
            </div>
            <a class="btn btn-art-secondary btn-sm" href="{{ path('app_front_activity_index', {age: child.age}) }}">Voir toutes les activites</a>
        </div>

        {% if recommendations %}
            <div class="row g-4">
                {% for item in recommendations %}
                    {% set activity = item.activity %}
                    <div class="col-md-6 col-xl-3">
                        <article class="art-card recommendation-card h-100 overflow-hidden hover-lift">
                            <img class="parent-card-media activity-image" src="{{ activity_image_url(activity.image) }}" alt="{{ activity.titre }}">
                            <div class="card-body p-4">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <span class="art-badge">{{ activity.category.nom }}</span>
                                    <span class="badge text-bg-success">{{ activity.statut.value }}</span>
                                </div>
                                <h3 class="h5 mb-2">{{ activity.titre }}</h3>
                                <p class="recommendation-reason small mb-3">{{ item.reason }}</p>
                                <ul class="list-unstyled small recommendation-meta mb-4">
                                    <li><i class="bi bi-calendar-event me-2"></i>{{ activity.dateActivite|date('d/m/Y') }}</li>
                                    <li><i class="bi bi-people me-2"></i>{{ activity.ageMin }} - {{ activity.ageMax }} ans</li>
                                    <li><i class="bi bi-ticket-perforated me-2"></i>{{ activity.placesDisponibles }} place(s) disponible(s)</li>
                                    <li><i class="bi bi-stars me-2"></i>Score de pertinence : {{ item.score }}</li>
                                </ul>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-art-secondary btn-sm" href="{{ path('app_front_activity_show', {id: activity.id}) }}">Voir details</a>
                                    {% if activity.estDisponible %}
                                        <a class="btn btn-art-primary btn-sm" href="{{ path('app_front_activity_show', {id: activity.id, child: child.id}) }}">Reserver</a>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="art-empty-state">
                Aucune activite recommandee pour le moment.
            </div>
        {% endif %}
    </section>
{% endblock %}
