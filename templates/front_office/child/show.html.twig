{% extends 'base.html.twig' %}

{% block title %}Fiche enfant | Art Kids{% endblock %}

{% block body %}
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 mb-0">{{ child.fullName }}</h1>
                <a class="btn btn-outline-primary" href="{{ path('app_front_child_edit', {id: child.id}) }}">Modifier</a>
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-4">Date de naissance</dt>
                <dd class="col-sm-8">{{ child.dateNaissance|date('d/m/Y') }}</dd>
                <dt class="col-sm-4">Age</dt>
                <dd class="col-sm-8">{{ child.age }} ans</dd>
                <dt class="col-sm-4">Sexe</dt>
                <dd class="col-sm-8">{{ child.sexe.value }}</dd>
            </dl>
        </div>
    </div>
{% endblock %}
