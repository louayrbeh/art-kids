{% extends 'base.html.twig' %}

{% block title %}Mes enfants | Art Kids{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Mes enfants</h1>
        <a class="btn btn-primary" href="{{ path('app_front_child_new') }}">Ajouter un enfant</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            {% if children %}
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Date de naissance</th>
                                <th>Age</th>
                                <th>Sexe</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for child in children %}
                                <tr>
                                    <td>{{ child.fullName }}</td>
                                    <td>{{ child.dateNaissance|date('d/m/Y') }}</td>
                                    <td>{{ child.age }} ans</td>
                                    <td>{{ child.sexe.value }}</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_front_child_show', {id: child.id}) }}">Voir</a>
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_front_child_edit', {id: child.id}) }}">Modifier</a>
                                        <form method="post" action="{{ path('app_front_child_delete', {id: child.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_child_' ~ child.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer cet enfant ?');">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">Aucun enfant enregistre pour le moment.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
