{% extends 'base.html.twig' %}

{% block title %}Modifier un enfant | Art Kids{% endblock %}

{% block body %}
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-4">Modifier {{ child.fullName }}</h1>
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.nom) }}</div>
                    <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                    <div class="col-md-6">{{ form_row(form.dateNaissance) }}</div>
                    <div class="col-md-6">{{ form_row(form.sexe) }}</div>
                </div>
                <div class="mt-4">{{ form_row(form.save) }}</div>
                    {{ form_end(form) }}
                </div>
            </div>
{% endblock %}
