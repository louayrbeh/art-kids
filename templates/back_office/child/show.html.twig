{% extends 'back_office/layout.html.twig' %}

{% block title %}Enfant | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">{{ child.fullName }}</h1>
            <p class="art-page-subtitle">Detail de l enfant et de ses reservations associees.</p>
        </div>
        <a class="btn btn-art-secondary" href="{{ path('app_back_child_index') }}">Retour a la liste</a>
    </div>

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="art-detail-card">
                <div class="art-detail-grid">
                    <div class="art-detail-item"><div class="art-detail-label">Parent</div><div class="art-detail-value">{{ child.parent.fullName }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Date de naissance</div><div class="art-detail-value">{{ child.dateNaissance|date('d/m/Y') }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Age</div><div class="art-detail-value">{{ child.age }} ans</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Sexe</div><div class="art-detail-value">{{ child.sexe.value }}</div></div>
                </div>
            </div>
        </div>
        <div class="col-xl-7">
            <div class="art-detail-card">
                <h3 class="h5 mb-3">Reservations liees</h3>
                {% if child.reservations|length > 0 %}
                    <ul class="list-group list-group-flush">
                        {% for reservation in child.reservations %}
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">{{ reservation.activity.titre }}</div>
                                    <div class="small text-muted">{{ reservation.dateReservation|date('d/m/Y H:i') }}</div>
                                </div>
                                <a class="art-action-btn art-action-view" href="{{ path('app_back_reservation_show', {id: reservation.id}) }}" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="art-empty-state py-4">
                        <i class="bi bi-journal-check"></i>
                        <h3>Aucune reservation</h3>
                        <p class="mb-0">Aucune reservation pour cet enfant.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
