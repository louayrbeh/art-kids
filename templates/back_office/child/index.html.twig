{% extends 'back_office/layout.html.twig' %}

{% block title %}Enfants | Admin{% endblock %}

{% block admin_body %}
    <div class="mb-4">
        <h2 class="h3 mb-1">Enfants</h2>
        <p class="text-muted mb-0">Consultation des enfants et de leur parent de rattachement.</p>
    </div>

    <div class="admin-surface p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Parent</th>
                        <th>Age</th>
                        <th>Sexe</th>
                        <th>Reservations</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for child in children %}
                        <tr>
                            <td class="fw-semibold">{{ child.fullName }}</td>
                            <td>{{ child.parent.fullName }}</td>
                            <td>{{ child.age }} ans</td>
                            <td>{{ child.sexe.value }}</td>
                            <td>{{ child.reservations|length }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary rounded-3" href="{{ path('app_back_child_show', {id: child.id}) }}">Voir</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-muted py-4">Aucun enfant enregistre.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
