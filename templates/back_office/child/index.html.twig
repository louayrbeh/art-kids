{% extends 'back_office/layout.html.twig' %}

{% block title %}Enfants | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">Enfants</h1>
            <p class="art-page-subtitle">Consultation des enfants et de leur parent de rattachement.</p>
        </div>
    </div>

    <div class="art-table-card">
        <div class="table-responsive">
            <table class="table art-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Parent</th>
                        <th>Age</th>
                        <th>Sexe</th>
                        <th>Reservations</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for child in children %}
                        <tr>
                            <td class="fw-semibold">{{ child.fullName }}</td>
                            <td>{{ child.parent.fullName }}</td>
                            <td>{{ child.age }} ans</td>
                            <td>{{ child.sexe.value }}</td>
                            <td>{{ child.reservations|length }}</td>
                            <td class="text-end">
                                <a class="art-action-btn art-action-view" href="{{ path('app_back_child_show', {id: child.id}) }}" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-4">
                                <div class="art-empty-state">
                                    <i class="bi bi-person-heart"></i>
                                    <h3>Aucun enfant</h3>
                                    <p class="mb-0">Les enfants rattachés aux parents s’afficheront ici.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
