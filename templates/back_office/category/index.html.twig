{% extends 'base.html.twig' %}

{% block title %}Categories | Admin{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Categories</h1>
        <a class="btn btn-primary" href="{{ path('app_back_category_new') }}">Nouvelle categorie</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.nom }}</td>
                            <td>{{ category.description ?: '-' }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_back_category_show', {id: category.id}) }}">Voir</a>
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_back_category_edit', {id: category.id}) }}">Modifier</a>
                                <form method="post" action="{{ path('app_back_category_delete', {id: category.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer cette categorie ?');">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="text-muted">Aucune categorie.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
