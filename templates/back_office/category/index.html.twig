{% extends 'back_office/layout.html.twig' %}

{% block title %}Categories | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">Categories</h1>
            <p class="art-page-subtitle">Gestion des univers artistiques disponibles sur la plateforme.</p>
        </div>
        <a class="btn btn-art-primary" href="{{ path('app_back_category_new') }}">
            <i class="bi bi-tag-fill me-2"></i>Nouvelle categorie
        </a>
    </div>

    <div class="art-table-card">
        <div class="table-responsive">
            <table class="table art-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Activites</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>
                                <img src="{{ category_image_url(category.image) }}" alt="{{ category.nom }}" class="img-thumbnail admin-image-thumb category-image">
                            </td>
                            <td class="fw-semibold">{{ category.nom }}</td>
                            <td>{{ category.description ?: '-' }}</td>
                            <td>{{ category.activities|length }}</td>
                            <td class="text-end">
                                <a class="art-action-btn art-action-view" href="{{ path('app_back_category_show', {id: category.id}) }}" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="art-action-btn art-action-edit" href="{{ path('app_back_category_edit', {id: category.id}) }}" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_back_category_delete', {id: category.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                    <button class="art-action-btn art-action-delete" onclick="return confirm('Supprimer cette categorie ?');" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-4">
                                <div class="art-empty-state">
                                    <i class="bi bi-tags"></i>
                                    <h3>Aucune categorie</h3>
                                    <p class="mb-0">Commencez par creer un premier univers artistique.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
