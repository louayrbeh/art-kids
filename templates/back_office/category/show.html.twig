{% extends 'back_office/layout.html.twig' %}

{% block title %}Categorie | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">{{ category.nom }}</h1>
            <p class="art-page-subtitle">Detail de la categorie et de ses activites associees.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-art-primary" href="{{ path('app_back_category_edit', {id: category.id}) }}">Modifier</a>
            <a class="btn btn-art-secondary" href="{{ path('app_back_category_index') }}">Retour</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="art-detail-card">
                <div class="mb-4">
                    <img src="{{ category_image_url(category.image) }}" alt="{{ category.nom }}" class="img-fluid rounded-4 admin-image-preview category-image">
                </div>
                <div class="art-detail-grid">
                    <div class="art-detail-item">
                        <div class="art-detail-label">Nom</div>
                        <div class="art-detail-value">{{ category.nom }}</div>
                    </div>
                    <div class="art-detail-item">
                        <div class="art-detail-label">Activites liees</div>
                        <div class="art-detail-value">{{ category.activities|length }}</div>
                    </div>
                    <div class="art-detail-item art-detail-item--full">
                        <div class="art-detail-label">Description</div>
                        <div class="art-detail-value">{{ category.description ?: 'Aucune description renseignee.' }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="art-detail-card">
                <h3 class="h5 mb-3">Activites liees</h3>
                {% if category.activities|length > 0 %}
                    <ul class="list-group list-group-flush">
                        {% for activity in category.activities %}
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span>{{ activity.titre }}</span>
                                <a class="small text-decoration-none fw-semibold" href="{{ path('app_back_activity_show', {id: activity.id}) }}">Voir</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="art-empty-state py-4">
                        <i class="bi bi-palette"></i>
                        <h3>Aucune activite</h3>
                        <p class="mb-0">Aucune activite pour cette categorie.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
