{% extends 'base.html.twig' %}

{% block title %}Categorie | Admin{% endblock %}

{% block body %}
    <div class="card shadow-sm"><div class="card-body">
        <h1 class="h4 mb-4">{{ category.nom }}</h1>
        <p>{{ category.description ?: 'Aucune description.' }}</p>
        <p class="text-muted mb-0">Nombre d'activites : {{ category.activities|length }}</p>
    </div></div>
{% endblock %}
