{% extends 'back_office/layout.html.twig' %}

{% block title %}Modifier categorie | Admin{% endblock %}

{% block admin_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Modifier {{ category.nom }}</h2>
            <p class="text-muted mb-0">Mettez a jour les informations de la categorie.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-4" href="{{ path('app_back_category_show', {id: category.id}) }}">Voir la fiche</a>
    </div>

    <div class="admin-surface admin-form-card p-4 p-lg-5">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_errors(form) }}
            {% if category.image %}
                <div class="mb-4">
                    <p class="fw-semibold mb-2">Image actuelle</p>
                    <img src="{{ asset('uploads/categories/' ~ category.image) }}" alt="{{ category.nom }}" class="img-fluid rounded-4 admin-image-preview category-image">
                </div>
            {% endif %}
            <div class="row g-4">
                <div class="col-md-6">{{ form_row(form.nom) }}</div>
                <div class="col-md-6">{{ form_row(form.imageFile) }}</div>
                <div class="col-12">{{ form_row(form.description) }}</div>
            </div>
            <div class="mt-4 d-flex gap-3">
                {{ form_widget(form.save, { attr: { class: 'btn btn-primary rounded-4 px-4' } }) }}
                <a class="btn btn-outline-secondary rounded-4 px-4" href="{{ path('app_back_category_index') }}">Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
