{% extends 'back_office/layout.html.twig' %}

{% block title %}Modifier categorie | Admin{% endblock %}

{% block admin_body %}
    <div class="art-form-page">
        <div class="art-form-card animate-slide-up">
            <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="art-badge">ArtKids Admin</span>
                    <h1 class="art-form-title mt-3 mb-2">Modifier {{ category.nom }}</h1>
                    <p class="art-form-subtitle mb-0">Mettez a jour les informations visuelles et textuelles de cette categorie.</p>
                </div>
                <a class="btn btn-art-secondary" href="{{ path('app_back_category_show', {id: category.id}) }}">
                    <i class="bi bi-eye me-1"></i>Voir la fiche
                </a>
            </div>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'art-form'}}) }}
                {{ form_errors(form) }}

                <div class="art-fieldset">
                    <div class="art-fieldset-title">Presentation de la categorie</div>

                    {% if category.image %}
                        <div class="art-upload-preview mb-4">
                            <div class="fw-semibold mb-2">Image actuelle</div>
                            <img src="{{ category_image_url(category.image) }}" alt="{{ category.nom }}" class="img-fluid admin-image-preview category-image">
                        </div>
                    {% endif %}

                    <div class="row g-4">
                        <div class="col-md-6">{{ form_row(form.nom) }}</div>
                        <div class="col-md-6">
                            <div class="art-upload-panel">
                                {{ form_row(form.imageFile) }}
                                <div class="art-upload-meta">Formats acceptes : JPG, PNG, WEBP. Taille maximale : 2 Mo.</div>
                                <div class="art-upload-filename" data-upload-filename>Aucun fichier selectionne</div>
                            </div>
                        </div>
                        <div class="col-12">{{ form_row(form.description) }}</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    {{ form_widget(form.save, { attr: { class: 'btn btn-art-primary' } }) }}
                    <a class="btn btn-art-secondary" href="{{ path('app_back_category_index') }}">Retour</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
