{% extends 'base.html.twig' %}

{% set currentRoute = app.request.attributes.get('_route') %}
{% set adminNavigation = [
    { route: 'app_back_admin_index', label: 'Dashboard', icon: 'bi-grid-1x2-fill', prefix: 'app_back_admin' },
    { route: 'app_back_category_index', label: 'Categories', icon: 'bi-tags-fill', prefix: 'app_back_category' },
    { route: 'app_back_activity_index', label: 'Activites', icon: 'bi-palette-fill', prefix: 'app_back_activity' },
    { route: 'app_back_user_index', label: 'Utilisateurs', icon: 'bi-people-fill', prefix: 'app_back_user' },
    { route: 'app_back_user_new', label: 'Creer un utilisateur', icon: 'bi-person-plus-fill', prefix: 'app_back_user' },
    { route: 'app_back_child_index', label: 'Enfants', icon: 'bi-balloon-heart-fill', prefix: 'app_back_child' },
    { route: 'app_back_reservation_index', label: 'Reservations', icon: 'bi-journal-check', prefix: 'app_back_reservation' }
] %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-admin.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-compact.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-card-spacing.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/artkids-sidebar.css') }}">
{% endblock %}

{% block body_class %}art-admin-body{% endblock %}
{% block navbar %}{% endblock %}
{% block main_class %}p-0{% endblock %}
{% block flashes %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="admin-shell">
        <div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
            <div class="offcanvas-header border-bottom">
                <div>
                    <div class="admin-brand mb-1">
                        <span class="admin-brand-art">Art</span><span class="admin-brand-kids">Kids</span>
                    </div>
                    <p class="small text-muted mb-0" id="adminSidebarLabel">Back-Office administrateur</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column">
                <nav class="nav flex-column gap-2">
                    {% for item in adminNavigation %}
                        {% set isActive = item.route == 'app_back_admin_index'
                            ? currentRoute in ['app_back_admin_index', 'app_back_office_admin_dashboard']
                            : currentRoute starts with item.prefix %}
                        <a class="admin-nav-link {{ isActive ? 'active' : '' }}" href="{{ path(item.route) }}">
                            <i class="bi {{ item.icon }}"></i>
                            <span>{{ item.label }}</span>
                        </a>
                    {% endfor %}
                </nav>
                <div class="mt-auto pt-4 d-grid gap-2">
                    <a class="btn btn-art-outline" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right me-2"></i>Deconnexion
                    </a>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row g-0 admin-dashboard-layout">
                <aside class="d-none d-lg-block admin-sidebar art-sidebar">
                    <div class="admin-sidebar-inner">
                        <div class="mb-4">
                            <div class="admin-brand art-sidebar-brand mb-1">
                                <span class="admin-brand-art">Art</span><span class="admin-brand-kids">Kids</span>
                            </div>
                            <p class="small text-muted mb-0">Administration de la plateforme</p>
                        </div>

                        <nav class="nav flex-column gap-2">
                            {% for item in adminNavigation %}
                                {% set isActive = item.route == 'app_back_admin_index'
                                    ? currentRoute in ['app_back_admin_index', 'app_back_office_admin_dashboard']
                                    : currentRoute starts with item.prefix %}
                                <a class="admin-nav-link {{ isActive ? 'active' : '' }}" href="{{ path(item.route) }}">
                                    <i class="bi {{ item.icon }}"></i>
                                    <span>{{ item.label }}</span>
                                </a>
                            {% endfor %}
                        </nav>

                        <div class="admin-sidebar-footer mt-auto">
                            <a class="btn btn-art-outline w-100" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right me-2"></i>Deconnexion
                            </a>
                        </div>
                    </div>
                </aside>

                <div class="admin-content">
                    <header class="admin-topbar">
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-light d-lg-none rounded-4 shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
                                <i class="bi bi-list fs-5"></i>
                            </button>
                            <div>
                                <p class="text-muted small mb-1">Espace securise</p>
                                <h1 class="h5 mb-0">Administration ArtKids</h1>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="admin-user-chip">
                                <span class="admin-user-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                <div>
                                    <div class="small text-muted">Connecte en tant que</div>
                                    <div class="fw-semibold">{{ app.user ? app.user.fullName : 'Administrateur' }}</div>
                                </div>
                            </div>
                        </div>
                    </header>

                    <div class="admin-page art-page-shell">
                        {% set flashIcons = {
                            success: 'bi-check2-circle',
                            error: 'bi-exclamation-octagon',
                            danger: 'bi-exclamation-octagon',
                            warning: 'bi-exclamation-triangle',
                            info: 'bi-info-circle'
                        } %}
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                {% set normalized = label == 'error' ? 'danger' : label %}
                                <div class="alert alert-{{ normalized }} art-flash art-alert alert-dismissible fade show rounded-4 border-0 slide-up" role="alert">
                                    <span class="art-flash__icon"><i class="bi {{ flashIcons[normalized] ?? 'bi-bell' }}"></i></span>
                                    <div class="art-flash__content">{{ message }}</div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}

                        {% block admin_body %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
