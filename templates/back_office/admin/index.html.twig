{% extends 'base.html.twig' %}

{% block title %}Administration | Art Kids{% endblock %}

{% block body %}
    <div class="p-4 mb-4 bg-white border rounded-3">
        <h1 class="h3 mb-2">Back-Office administrateur</h1>
        <p class="mb-0">Cette page reste simple pour cette etape, avec des acces rapides vers les CRUD et un resume des statistiques.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Parents</div><div class="h3 mb-0">{{ summary.parents }}</div></div></div></div>
        <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Enfants</div><div class="h3 mb-0">{{ summary.children }}</div></div></div></div>
        <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Activites</div><div class="h3 mb-0">{{ summary.activities }}</div></div></div></div>
        <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Reservations</div><div class="h3 mb-0">{{ summary.reservations }}</div></div></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Acces rapides</h2>
                    <div class="list-group">
                        <a class="list-group-item list-group-item-action" href="{{ path('app_back_category_index') }}">Gerer les categories</a>
                        <a class="list-group-item list-group-item-action" href="{{ path('app_back_activity_index') }}">Gerer les activites</a>
                        <a class="list-group-item list-group-item-action" href="{{ path('app_back_user_index') }}">Consulter les utilisateurs</a>
                        <a class="list-group-item list-group-item-action" href="{{ path('app_back_child_index') }}">Consulter les enfants</a>
                        <a class="list-group-item list-group-item-action" href="{{ path('app_back_reservation_index') }}">Consulter les reservations</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Activites les plus reservees</h2>
                    {% if mostReserved %}
                        <ul class="list-group list-group-flush">
                            {% for item in mostReserved %}
                                <li class="list-group-item px-0 d-flex justify-content-between">
                                    <span>{{ item.activity.titre }}</span>
                                    <span class="badge text-bg-secondary">{{ item.reservationCount }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Aucune reservation enregistree.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
