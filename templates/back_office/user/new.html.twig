{% extends 'back_office/layout.html.twig' %}

{% block title %}Nouvel utilisateur | Admin{% endblock %}

{% block admin_body %}
    <div class="art-form-page">
        <div class="art-form-card animate-slide-up">
            <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="art-badge">ArtKids Admin</span>
                    <h1 class="art-form-title mt-3 mb-2">Creer un utilisateur</h1>
                    <p class="art-form-subtitle mb-0">Creez un compte parent ou administrateur depuis le Back-Office avec des droits controles.</p>
                </div>
                <a class="btn btn-art-secondary" href="{{ path('app_back_user_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Retour a la liste
                </a>
            </div>

            {{ form_start(form, {'attr': {'class': 'art-form'}}) }}
                {{ form_errors(form) }}

                <div class="art-fieldset">
                    <div class="art-fieldset-title">Informations personnelles</div>
                    <div class="row g-4">
                        <div class="col-md-6">{{ form_row(form.nom) }}</div>
                        <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                        <div class="col-md-6">{{ form_row(form.email) }}</div>
                        <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                    </div>
                </div>

                <div class="art-fieldset">
                    <div class="art-fieldset-title">Securite et permissions</div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            {{ form_row(form.plainPassword) }}
                            <div class="form-text">Le mot de passe doit etre suffisamment securise.</div>
                        </div>
                        <div class="col-md-6">{{ form_row(form.roles) }}</div>
                        <div class="col-md-6">{{ form_row(form.isActive) }}</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    {{ form_widget(form.save, { attr: { class: 'btn btn-art-primary' } }) }}
                    <a class="btn btn-art-secondary" href="{{ path('app_back_user_index') }}">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
