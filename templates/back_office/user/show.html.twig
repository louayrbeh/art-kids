{% extends 'back_office/layout.html.twig' %}

{% block title %}Utilisateur | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">{{ user.fullName }}</h1>
            <p class="art-page-subtitle">Detail du compte administrateur ou parent.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-art-primary" href="{{ path('app_back_user_edit', {id: user.id}) }}">Modifier</a>
            <a class="btn btn-art-secondary" href="{{ path('app_back_user_index') }}">Retour a la liste</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="art-detail-card">
                <div class="art-detail-grid">
                    <div class="art-detail-item"><div class="art-detail-label">Email</div><div class="art-detail-value">{{ user.email }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Telephone</div><div class="art-detail-value">{{ user.telephone ?: '-' }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Role</div><div class="art-detail-value">{{ user.isAdmin ? 'ROLE_ADMIN' : 'ROLE_PARENT' }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Statut</div><div class="art-detail-value">{{ user.isActive ? 'Actif' : 'Desactive' }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Date creation</div><div class="art-detail-value">{{ user.createdAt|date('d/m/Y H:i') }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Derniere mise a jour</div><div class="art-detail-value">{{ user.updatedAt ? user.updatedAt|date('d/m/Y H:i') : '-' }}</div></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="art-detail-card">
                <h3 class="h5 mb-3">Resume</h3>
                <p class="mb-2"><strong>{{ user.children|length }}</strong> enfant(s) rattache(s)</p>
                <p class="mb-0 text-muted">Les comptes avec historique sont de preference desactives plutot que supprimes.</p>
            </div>
        </div>
    </div>
{% endblock %}
