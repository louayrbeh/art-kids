{% extends 'base.html.twig' %}

{% block title %}Utilisateur | Admin{% endblock %}

{% block body %}
    <div class="card shadow-sm"><div class="card-body">
        <h1 class="h4 mb-4">{{ user.fullName }}</h1>
        <dl class="row mb-0">
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">{{ user.email }}</dd>
            <dt class="col-sm-4">Telephone</dt><dd class="col-sm-8">{{ user.telephone ?: '-' }}</dd>
            <dt class="col-sm-4">Roles</dt><dd class="col-sm-8">{{ user.roles|join(', ') }}</dd>
            <dt class="col-sm-4">Actif</dt><dd class="col-sm-8">{{ user.isActive ? 'Oui' : 'Non' }}</dd>
            <dt class="col-sm-4">Enfants</dt><dd class="col-sm-8">{{ user.children|length }}</dd>
        </dl>
    </div></div>
{% endblock %}
