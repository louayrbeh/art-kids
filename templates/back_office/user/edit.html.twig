{% extends 'back_office/layout.html.twig' %}

{% block title %}Modifier utilisateur | Admin{% endblock %}

{% block admin_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Modifier {{ user.fullName }}</h2>
            <p class="text-muted mb-0">Laissez le mot de passe vide pour conserver l ancien.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-4" href="{{ path('app_back_user_show', {id: user.id}) }}">Voir la fiche</a>
    </div>

    <div class="admin-surface admin-form-card p-4 p-lg-5">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-4">
                <div class="col-md-6">{{ form_row(form.nom) }}</div>
                <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                <div class="col-md-6">{{ form_row(form.email) }}</div>
                <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                <div class="col-md-6">{{ form_row(form.plainPassword) }}</div>
                <div class="col-md-6">{{ form_row(form.roles) }}</div>
                <div class="col-md-6">{{ form_row(form.isActive) }}</div>
            </div>
            <div class="mt-4 d-flex gap-3">
                {{ form_widget(form.save, { attr: { class: 'btn btn-primary rounded-4 px-4' } }) }}
                <a class="btn btn-outline-secondary rounded-4 px-4" href="{{ path('app_back_user_index') }}">Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
