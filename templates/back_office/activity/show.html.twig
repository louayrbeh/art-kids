{% extends 'back_office/layout.html.twig' %}

{% block title %}Activite | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">{{ activity.titre }}</h1>
            <p class="art-page-subtitle">Fiche detaillee de l activite et de ses regles de reservation.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-art-primary" href="{{ path('app_back_activity_edit', {id: activity.id}) }}">Modifier</a>
            <a class="btn btn-art-secondary" href="{{ path('app_back_activity_index') }}">Retour</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="art-detail-card">
                <div class="mb-4">
                    <img src="{{ activity_image_url(activity.image) }}" alt="{{ activity.titre }}" class="img-fluid rounded-4 admin-image-preview activity-image">
                </div>
                <div class="art-detail-grid">
                    <div class="art-detail-item"><div class="art-detail-label">Categorie</div><div class="art-detail-value">{{ activity.category.nom }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Date</div><div class="art-detail-value">{{ activity.dateActivite|date('d/m/Y') }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Horaire</div><div class="art-detail-value">{{ activity.heureDebut|date('H:i') }} - {{ activity.heureFin|date('H:i') }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Lieu</div><div class="art-detail-value">{{ activity.lieu ?: 'A definir' }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Prix</div><div class="art-detail-value">{{ activity.prix ?: 'Gratuit' }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Statut</div><div class="art-detail-value">{{ activity.statut.value }}</div></div>
                    <div class="art-detail-item art-detail-item--full"><div class="art-detail-label">Description</div><div class="art-detail-value">{{ activity.description }}</div></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="art-detail-card">
                <h3 class="h5 mb-3">Capacite et ages</h3>
                <div class="art-detail-grid">
                    <div class="art-detail-item"><div class="art-detail-label">Capacite maximale</div><div class="art-detail-value">{{ activity.capaciteMax }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Places disponibles</div><div class="art-detail-value">{{ activity.placesDisponibles }}</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Age minimum</div><div class="art-detail-value">{{ activity.ageMin }} ans</div></div>
                    <div class="art-detail-item"><div class="art-detail-label">Age maximum</div><div class="art-detail-value">{{ activity.ageMax }} ans</div></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
