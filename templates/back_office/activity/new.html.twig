{% extends 'back_office/layout.html.twig' %}

{% block title %}Nouvelle activite | Admin{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('js/activity-ai.js') }}"></script>
{% endblock %}

{% block admin_body %}
    <div class="art-form-page">
        <div class="art-form-card animate-slide-up">
            <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="art-badge">ArtKids Admin</span>
                    <h1 class="art-form-title mt-3 mb-2">Nouvelle activite</h1>
                    <p class="art-form-subtitle mb-0">Creez une activite artistique complete avec image, planning, capacite et description assistee par IA.</p>
                </div>
                <a class="btn btn-art-secondary" href="{{ path('app_back_activity_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Retour a la liste
                </a>
            </div>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'art-form'}}) }}
                {{ form_errors(form) }}

                <div class="art-fieldset">
                    <div class="art-fieldset-title">Informations generales</div>
                    <div class="row g-4">
                        <div class="col-lg-6">{{ form_row(form.titre) }}</div>
                        <div class="col-lg-6">{{ form_row(form.category) }}</div>
                        <div class="col-lg-6">{{ form_row(form.lieu) }}</div>
                        <div class="col-lg-6">
                            <div class="art-upload-panel">
                                {{ form_row(form.imageFile) }}
                                <div class="art-upload-meta">Formats acceptes : JPG, PNG, WEBP. Taille maximale : 2 Mo.</div>
                                <div class="art-upload-filename" data-upload-filename>Aucun fichier selectionne</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="art-fieldset">
                    <div class="art-fieldset-title">Planning et capacite</div>
                    <div class="row g-4">
                        <div class="col-md-4">{{ form_row(form.dateActivite) }}</div>
                        <div class="col-md-4">{{ form_row(form.heureDebut) }}</div>
                        <div class="col-md-4">{{ form_row(form.heureFin) }}</div>
                        <div class="col-md-3">{{ form_row(form.capaciteMax) }}</div>
                        <div class="col-md-3">{{ form_row(form.ageMin) }}</div>
                        <div class="col-md-3">{{ form_row(form.ageMax) }}</div>
                        <div class="col-md-3">{{ form_row(form.prix) }}</div>
                        <div class="col-md-6">{{ form_row(form.statut) }}</div>
                    </div>
                </div>

                <div class="art-fieldset">
                    <div class="art-fieldset-title">Description et assistant IA</div>
                    {{ form_row(form.description) }}
                    <div class="art-ai-panel mt-3">
                        <div class="art-ai-panel__header">
                            <span class="art-ai-panel__icon"><i class="bi bi-stars"></i></span>
                            <div>
                                <div class="art-ai-panel__title">Assistant de description IA</div>
                                <p class="art-ai-panel__text">Vous pouvez remplir la description manuellement ou la generer automatiquement a partir du titre, de la categorie et de la tranche d age.</p>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <button
                                type="button"
                                class="btn btn-art-secondary"
                                data-activity-ai-generate
                                data-generate-url="{{ path('app_back_office_activity_generate_description') }}"
                            >
                                <i class="bi bi-stars me-2"></i>Generer avec IA
                            </button>
                            <input type="hidden" value="{{ csrf_token('generate_activity_description') }}" data-activity-ai-csrf>
                        </div>
                        <div class="mt-3" data-activity-ai-feedback></div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    {{ form_widget(form.save, { attr: { class: 'btn btn-art-primary' } }) }}
                    <a class="btn btn-art-secondary" href="{{ path('app_back_activity_index') }}">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
