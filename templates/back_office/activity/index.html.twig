{% extends 'back_office/layout.html.twig' %}

{% block title %}Activites | Admin{% endblock %}

{% block admin_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Activites</h2>
            <p class="text-muted mb-0">Catalogue des activites artistiques gerees dans MySQL.</p>
        </div>
        <a class="btn btn-primary rounded-4 px-4" href="{{ path('app_back_activity_new') }}">
            <i class="bi bi-palette-fill me-2"></i>Nouvelle activite
        </a>
    </div>

    <div class="admin-surface p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table mb-0">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Categorie</th>
                        <th>Date</th>
                        <th>Capacite</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for activity in activities %}
                        <tr>
                            <td>
                                {% if activity.image %}
                                    <img src="{{ asset('uploads/activities/' ~ activity.image) }}" alt="{{ activity.titre }}" class="img-thumbnail admin-image-thumb activity-image">
                                {% else %}
                                    <div class="activity-placeholder admin-placeholder-sm"><i class="bi bi-image"></i></div>
                                {% endif %}
                            </td>
                            <td class="fw-semibold">{{ activity.titre }}</td>
                            <td>{{ activity.category.nom }}</td>
                            <td>{{ activity.dateActivite|date('d/m/Y') }}</td>
                            <td>{{ activity.capaciteMax }}</td>
                            <td><span class="badge text-bg-{{ activity.statut.value == 'OUVERTE' ? 'success' : (activity.statut.value == 'COMPLETE' ? 'warning' : (activity.statut.value == 'ANNULEE' ? 'danger' : 'secondary')) }}">{{ activity.statut.value }}</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary rounded-3" href="{{ path('app_back_activity_show', {id: activity.id}) }}">Voir</a>
                                <a class="btn btn-sm btn-outline-primary rounded-3" href="{{ path('app_back_activity_edit', {id: activity.id}) }}">Modifier</a>
                                <form method="post" action="{{ path('app_back_activity_delete', {id: activity.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_activity_' ~ activity.id) }}">
                                    <button class="btn btn-sm btn-outline-danger rounded-3" onclick="return confirm('Supprimer cette activite ?');">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-muted py-4">Aucune activite enregistree.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
