{% extends 'back_office/layout.html.twig' %}

{% block title %}Activites | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">Activites</h1>
            <p class="art-page-subtitle">Catalogue des activites artistiques gerees dans MySQL.</p>
        </div>
        <a class="btn btn-art-primary" href="{{ path('app_back_activity_new') }}">
            <i class="bi bi-palette-fill me-2"></i>Nouvelle activite
        </a>
    </div>

    <div class="art-table-card">
        <div class="table-responsive">
            <table class="table art-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Categorie</th>
                        <th>Date</th>
                        <th>Capacite</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for activity in activities %}
                        <tr>
                            <td>
                                <img src="{{ activity_image_url(activity.image) }}" alt="{{ activity.titre }}" class="img-thumbnail admin-image-thumb activity-image">
                            </td>
                            <td class="fw-semibold">{{ activity.titre }}</td>
                            <td>{{ activity.category.nom }}</td>
                            <td>{{ activity.dateActivite|date('d/m/Y') }}</td>
                            <td>{{ activity.capaciteMax }}</td>
                            <td>
                                <span class="art-badge {{ activity.statut.value == 'OUVERTE' ? 'badge-art-success' : (activity.statut.value == 'COMPLETE' ? 'badge-art-warning' : (activity.statut.value == 'ANNULEE' ? 'badge-art-danger' : 'badge-art-muted')) }}">
                                    {{ activity.statut.value }}
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="art-action-btn art-action-view" href="{{ path('app_back_activity_show', {id: activity.id}) }}" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="art-action-btn art-action-edit" href="{{ path('app_back_activity_edit', {id: activity.id}) }}" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_back_activity_delete', {id: activity.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_activity_' ~ activity.id) }}">
                                    <button class="art-action-btn art-action-delete" onclick="return confirm('Supprimer cette activite ?');" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="py-4">
                                <div class="art-empty-state">
                                    <i class="bi bi-palette"></i>
                                    <h3>Aucune activite</h3>
                                    <p class="mb-0">Ajoutez une activite pour enrichir le catalogue.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
