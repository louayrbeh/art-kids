{% extends 'back_office/layout.html.twig' %}

{% block title %}Modifier activite | Admin{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('js/activity-ai.js') }}"></script>
{% endblock %}

{% block admin_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Modifier {{ activity.titre }}</h2>
            <p class="text-muted mb-0">Mettez a jour le planning, la capacite et le statut de l activite.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-4" href="{{ path('app_back_activity_show', {id: activity.id}) }}">Voir la fiche</a>
    </div>

    <div class="admin-surface admin-form-card p-4 p-lg-5">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_errors(form) }}
            {% if activity.image %}
                <div class="mb-4">
                    <p class="fw-semibold mb-2">Image actuelle</p>
                    <img src="{{ activity_image_url(activity.image) }}" alt="{{ activity.titre }}" class="img-fluid rounded-4 admin-image-preview activity-image">
                </div>
            {% endif %}
            <div class="row g-4">
                <div class="col-lg-6">{{ form_row(form.titre) }}</div>
                <div class="col-lg-6">{{ form_row(form.category) }}</div>
                <div class="col-12">
                    {{ form_row(form.description) }}
                    <div class="art-ai-panel mt-3">
                        <div class="art-ai-panel__header">
                            <span class="art-ai-panel__icon"><i class="bi bi-stars"></i></span>
                            <div>
                                <div class="art-ai-panel__title">Assistant de description IA</div>
                                <p class="art-ai-panel__text">Regenerer un texte professionnel depuis le titre, la categorie et la tranche d age, puis ajuster librement la description.</p>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <button
                                type="button"
                                class="btn btn-outline-primary rounded-4"
                                data-activity-ai-generate
                                data-generate-url="{{ path('app_back_office_activity_generate_description') }}"
                            >
                                <i class="bi bi-stars me-2"></i>Generer avec IA
                            </button>
                            <input type="hidden" value="{{ csrf_token('generate_activity_description') }}" data-activity-ai-csrf>
                        </div>
                        <div class="mt-3" data-activity-ai-feedback></div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="art-upload-panel">
                        {{ form_row(form.imageFile) }}
                        <div class="art-upload-meta">Formats acceptes : JPG, PNG, WEBP - taille maximale 2 Mo.</div>
                        <div class="art-upload-filename" data-upload-filename>Aucun fichier selectionne</div>
                    </div>
                </div>
                <div class="col-lg-6">{{ form_row(form.lieu) }}</div>
                <div class="col-md-4">{{ form_row(form.dateActivite) }}</div>
                <div class="col-md-4">{{ form_row(form.heureDebut) }}</div>
                <div class="col-md-4">{{ form_row(form.heureFin) }}</div>
                <div class="col-md-3">{{ form_row(form.capaciteMax) }}</div>
                <div class="col-md-3">{{ form_row(form.ageMin) }}</div>
                <div class="col-md-3">{{ form_row(form.ageMax) }}</div>
                <div class="col-md-3">{{ form_row(form.prix) }}</div>
                <div class="col-md-6">{{ form_row(form.statut) }}</div>
            </div>
            <div class="mt-4 d-flex gap-3">
                {{ form_widget(form.save, { attr: { class: 'btn btn-primary rounded-4 px-4' } }) }}
                <a class="btn btn-outline-secondary rounded-4 px-4" href="{{ path('app_back_activity_index') }}">Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
