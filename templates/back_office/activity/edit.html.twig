{% extends 'back_office/layout.html.twig' %}

{% block title %}Modifier activite | Admin{% endblock %}

{% block admin_body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Modifier {{ activity.titre }}</h2>
            <p class="text-muted mb-0">Mettez a jour le planning, la capacite et le statut de l activite.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-4" href="{{ path('app_back_activity_show', {id: activity.id}) }}">Voir la fiche</a>
    </div>

    <div class="admin-surface admin-form-card p-4 p-lg-5">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-4">
                <div class="col-lg-6">{{ form_row(form.titre) }}</div>
                <div class="col-lg-6">{{ form_row(form.category) }}</div>
                <div class="col-12">{{ form_row(form.description) }}</div>
                <div class="col-lg-6">{{ form_row(form.image) }}</div>
                <div class="col-lg-6">{{ form_row(form.lieu) }}</div>
                <div class="col-md-4">{{ form_row(form.dateActivite) }}</div>
                <div class="col-md-4">{{ form_row(form.heureDebut) }}</div>
                <div class="col-md-4">{{ form_row(form.heureFin) }}</div>
                <div class="col-md-3">{{ form_row(form.capaciteMax) }}</div>
                <div class="col-md-3">{{ form_row(form.ageMin) }}</div>
                <div class="col-md-3">{{ form_row(form.ageMax) }}</div>
                <div class="col-md-3">{{ form_row(form.prix) }}</div>
                <div class="col-md-6">{{ form_row(form.statut) }}</div>
            </div>
            <div class="mt-4 d-flex gap-3">
                {{ form_widget(form.save, { attr: { class: 'btn btn-primary rounded-4 px-4' } }) }}
                <a class="btn btn-outline-secondary rounded-4 px-4" href="{{ path('app_back_activity_index') }}">Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
