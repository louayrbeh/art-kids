{% extends 'back_office/layout.html.twig' %}

{% set reservationBadgeMap = {
    'EN_ATTENTE': 'warning',
    'CONFIRMEE': 'success',
    'ANNULEE': 'danger',
    'TERMINEE': 'secondary'
} %}

{% block title %}Reservations | Admin{% endblock %}

{% block admin_body %}
    <div class="art-page-header">
        <div>
            <h1 class="art-page-title">Reservations</h1>
            <p class="art-page-subtitle">Toutes les reservations avec leurs actions de confirmation et d annulation.</p>
        </div>
    </div>

    <div class="art-table-card">
        <div class="table-responsive">
            <table class="table art-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Parent</th>
                        <th>Enfant</th>
                        <th>Activite</th>
                        <th>Statut</th>
                        <th>Date reservation</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td>#{{ reservation.id }}</td>
                            <td>{{ reservation.child.parent.fullName }}</td>
                            <td>{{ reservation.child.fullName }}</td>
                            <td>{{ reservation.activity.titre }}</td>
                            <td><span class="art-badge {{ reservationBadgeMap[reservation.statut.value] == 'success' ? 'badge-art-success' : (reservationBadgeMap[reservation.statut.value] == 'warning' ? 'badge-art-warning' : (reservationBadgeMap[reservation.statut.value] == 'danger' ? 'badge-art-danger' : 'badge-art-muted')) }}">{{ reservation.statut.value }}</span></td>
                            <td>{{ reservation.dateReservation|date('d/m/Y H:i') }}</td>
                            <td class="text-end">
                                <a class="art-action-btn art-action-view" href="{{ path('app_back_reservation_show', {id: reservation.id}) }}" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                {% if reservation.statut.value == 'EN_ATTENTE' %}
                                    <form method="post" action="{{ path('app_back_reservation_confirm', {id: reservation.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('confirm_reservation_' ~ reservation.id) }}">
                                        <button class="art-action-btn art-action-confirm" title="Confirmer">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                {% endif %}
                                {% if reservation.statut.value != 'ANNULEE' %}
                                    <form method="post" action="{{ path('app_back_reservation_cancel', {id: reservation.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_admin_reservation_' ~ reservation.id) }}">
                                        <button class="art-action-btn art-action-delete" title="Annuler">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="py-4">
                                <div class="art-empty-state">
                                    <i class="bi bi-calendar-check"></i>
                                    <h3>Aucune reservation</h3>
                                    <p class="mb-0">Les reservations apparaîtront ici au fil des inscriptions.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
